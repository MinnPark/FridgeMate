# 쓰레기(재생성물)만 무시. 데이터(data/chroma)/.env.example 는 의도적으로 추적 = 팀 공유.
# (실제 .env 비밀키 파일만 무시 — example 은 추적)

# Python
__pycache__/
*.py[cod]
.Python
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage

# Node / Next
node_modules/
.next/
out/

# IDE
.vscode/
.idea/

# Jupyter / OS
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# 로그
*.log

# 노트북 실험 산출물 (재생성물 — data/chroma 는 추적하지만 lab 은 무시)
backend/data/lab/

# 데이터 파이프라인: 대용량 중간 산출물(재생성물, s0~s3로 재생성)은 무시.
# 투명성 산출물(품질 리포트·미리보기·수집 매니페스트)만 추적 = 팀이 실태를 코드 없이 본다.
backend/data/pipeline/00_raw/*.json
!backend/data/pipeline/00_raw/_manifest.json
backend/data/pipeline/01_normalized/*.json
backend/data/pipeline/02_clean/recipes.json
backend/data/pipeline/03_embed_ready/recipes.json

# 실제 비밀키 .env (example 은 추적 — 아래 negation. *.env 광역패턴은 example까지 먹어서 안 씀)
.env
.env.local
.env.*.local
!.env.example
!frontend/web/.env.local.example
