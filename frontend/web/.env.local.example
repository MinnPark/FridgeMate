# 복사해서 .env.local 로 사용.

# mock API 사용 여부 (기본 true → 백엔드 없이도 동작)
#  - /api/run, /api/cart 에만 적용된다.
#  - 쿠팡 자동 담기(executeCart → /api/cart/execute)는 실제 side-effect 이므로
#    이 값과 무관하게 항상 실제 FastAPI 백엔드를 호출한다(mock 성공 위장 없음).
NEXT_PUBLIC_USE_MOCK_API=true

# FastAPI 주소 (real 모드 + 자동 담기 실행에 사용)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 실제 API 호출 실패 시 mock 으로 fallback 할지 (/api/run, /api/cart 한정, 기본 true)
NEXT_PUBLIC_API_FALLBACK_TO_MOCK=true

# (구버전 호환) NEXT_PUBLIC_API_MODE=mock|real 도 인식한다.
# NEXT_PUBLIC_USE_MOCK_API 가 있으면 그쪽이 우선이다.
