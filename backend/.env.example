# FridgeMate-Merge .env 풀 템플릿 — 이 파일을 backend/.env 로 복사 후 *** 표시 비밀키만 채우면 구동.
# 비밀키는 보안상 레포에 안 박음(외부레포 자격증명 유출 방지). 각자/팀이 .env 에 채움.
# app/rag/__init__.py 가 import 시 load_dotenv() 자동 호출.
#
# *** = 채워야 구동되는 비밀키 (LMSTUDIO_API_KEY, OPENROUTER_API_KEY[, FOOD_SAFETY/MAFRA])

# ===== RAG 서브쿼리 LLM (HyDE 가상문서 / RAG-Fusion 멀티쿼리 생성) =====
# 티어링: 큰 오케스트레이션은 OpenRouter(Claude), 작은 서브쿼리는 LM Studio 로컬 서브모델.
LLM_PROVIDER=openrouter                              # anthropic | openrouter | local (오케스트레이션 기본)
RAG_LLM_PROVIDER=local                               # 서브쿼리 전용 provider (기본 local=LM Studio 서브모델)
LOCAL_MODEL_DEFAULT=qwen2.5-7b-instruct              # LM Studio 챗 서브모델 id (RAG_LLM_PROVIDER=local 시)
LLM_LOCAL_BASE_URL=                                  # 비우면 LMSTUDIO_BASE_URL 로 폴백 (로컬 LLM은 LMSTUDIO_API_KEY 인증)
OPENROUTER_API_KEY=                                  # *** 필수 — 채우세요
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_DEFAULT=anthropic/claude-sonnet-4-6
OPENROUTER_MODEL_JUDGE=anthropic/claude-opus-4-7
ANTHROPIC_API_KEY=                                   # (LLM_PROVIDER=anthropic 일 때만)
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
ANTHROPIC_MODEL_JUDGE=claude-opus-4-7
FRIDGEMATE_USE_LLM=true                              # false 면 HyDE/Fusion -> plain 벡터검색 폴백

# ===== 앱 에이전트 + 쿠팡 상품 판정 LLM (app/llm.py) =====
# Orchestrator/Meal/Shopping 및 쿠팡 상품 후보 의미 판정이 이 설정을 공유한다.
# OpenRouter 예시:
FRIDGEMATE_LLM_PROVIDER=openai                       # mock | openai | anthropic
FRIDGEMATE_LLM_BASE_URL=https://openrouter.ai/api/v1 # OpenAI 호환. 비우면 api.openai.com
FRIDGEMATE_LLM_MODEL=openai/gpt-4o-mini              # OpenRouter 모델 id (json 모드 지원)
OPENAI_API_KEY=                                      # *** OpenRouter 키(sk-or-...) 또는 OpenAI 키
#
# 로컬 LM Studio 예시(채팅 모델을 로드하고 Local Server 실행):
# FRIDGEMATE_LLM_PROVIDER=openai
# FRIDGEMATE_LLM_BASE_URL=http://127.0.0.1:1234/v1
# FRIDGEMATE_LLM_MODEL=qwen2.5-7b-instruct
# OPENAI_API_KEY=lm-studio                            # 실제 키가 아닌 빈 값 검사 통과용 문자열

# ===== Embedding (bge-m3 via LM Studio) =====
EMBED_PROVIDER=local                                 # local | cohere | mock
LMSTUDIO_BASE_URL=http://58.148.250.103:1234/v1      # 로컬이면 http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=                                    # *** 필수 (bge-m3 Bearer) — 채우세요
EMBED_MODEL_LOCAL=text-embedding-bge-m3
EMBED_SIG=bge-m3-1024                                # 벡터공간 식별자 (인덱스<->쿼리 일치 가드)
COHERE_API_KEY=                                      # (EMBED_PROVIDER=cohere 일 때만)
COHERE_MODEL=embed-multilingual-v3

# ===== Vector / 데이터 =====
CHROMADB_PATH=./data/chroma                          # 사전임베딩 산출물 (recipe_db 1693 동봉)

# ===== 데이터 소스 키 (사전임베딩 재빌드 scripts/ingest_recipes.py) =====
FOOD_SAFETY_API_KEY=                                 # *** 식약처 COOKRCP01 (재빌드 시 필요)
MAFRA_API_KEY=                                       # *** 농정원 레시피, IP 제한 (재빌드 시 필요)
RDA_API_KEY=                                         # 농진청 (옵션, 미구현 스텁)

# ===== 외부 API (shopping/cart — 후속 범위) =====
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
COUPANG_PARTNER_ACCESS_KEY=
COUPANG_PARTNER_SECRET_KEY=

# ===== 인프라 =====
REDIS_URL=redis://localhost:6379                     # 없으면 in-memory 폴백
DATABASE_URL=postgresql://fridgemate:fridgemate@localhost:5432/fridgemate
CHECKPOINTER_TYPE=memory                             # memory | sqlite | postgres

# ===== Observability (LangSmith) =====
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=fridgemate-merge

# ===== Dev =====
FRIDGEMATE_MOCK_MODE=true                            # 외부 tool mock (임베딩/LLM 은 위 설정대로 real)
