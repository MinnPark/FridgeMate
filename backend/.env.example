# FridgeMate-Merge — RAG 이식분 환경변수 (오늘 RAG 범위)
# 전체 앱 .env 적용은 후속 업그레이드. 지금은 RAG 엔진/사전임베딩이 쓰는 것만.
# app/rag/__init__.py 가 import 시 load_dotenv() 로 자동 로드.

# ── 임베딩 (bge-m3 via LM Studio; 로컬 또는 원격 서빙) ──
EMBED_PROVIDER=local
LMSTUDIO_BASE_URL=http://58.148.250.103:1234/v1   # 로컬이면 http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=
EMBED_MODEL_LOCAL=text-embedding-bge-m3
EMBED_SIG=bge-m3-1024            # 벡터공간 식별자(인덱스↔쿼리 일치 가드). base_url 과 무관 고정.
CHROMADB_PATH=./data/chroma      # 사전임베딩 산출물 위치 (backend/data/chroma)

# ── LLM (HyDE 가상문서 / RAG-Fusion 멀티쿼리 생성) ──
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_DEFAULT=anthropic/claude-sonnet-4-6
FRIDGEMATE_USE_LLM=true          # false 면 HyDE/Fusion 이 plain 벡터검색으로 폴백

# ── 사전임베딩 재빌드용 데이터 소스 키 (scripts/ingest_recipes.py) ──
FOOD_SAFETY_API_KEY=             # 식약처 COOKRCP01
MAFRA_API_KEY=                   # 농정원 레시피 (IP 제한: 호출서버 IP 등록 필요)
