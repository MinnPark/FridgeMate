# ============================================================================
# FridgeMate-Merge  —  backend/.env 템플릿
# ----------------------------------------------------------------------------
# 사용법: 이 파일을 backend/.env 로 복사한 뒤, 아래 [*] 표시된 비밀키만 채우면 구동.
#   cp .env.example .env   (그리고 [*] 칸 채우기)
# 주의: 실제 비밀키는 .env(=gitignored)에만. 이 .env.example 은 **커밋되는 파일**이라
#       절대 실제 키를 넣지 말 것(공유 레포 유출). 여기엔 빈 칸/플레이스홀더만 둔다.
# 로딩: app/rag/__init__.py 가 import 시 load_dotenv() 자동 호출.
#
# [*] = 채워야 동작하는 비밀키
# ============================================================================


# ============================================================================
# 1) LLM 시스템 — 현재 두 갈래가 공존한다 (정리 대상이지만 둘 다 살아있음)
#    (A) RAG + v3 노드(intake/judge)  -> app/rag/_llm.py   : LLM_PROVIDER / RAG_LLM_PROVIDER
#    (B) 레거시 에이전트(orch/meal/shopping) -> app/llm.py  : FRIDGEMATE_LLM_*
#    둘 다 결국 OpenRouter(Claude/GPT)로 가지만 env 변수와 기본 모델이 다르다.
# ============================================================================

# --- 전역 토글 ---
FRIDGEMATE_USE_LLM=true            # false 면 모든 LLM 호출 -> 휴리스틱/plain 폴백(오프라인 동작)

# --- (A) RAG + v3 오케스트레이션 LLM  [app/rag/_llm.py] ---
# 큰 일(intake 파싱 / judge 검증)은 Claude, 검색 서브쿼리는 로컬 qwen 으로 티어 분리.
LLM_PROVIDER=openrouter            # anthropic | openrouter | local  (오케스트레이션 provider)
RAG_LLM_PROVIDER=local             # 검색 서브쿼리(HyDE/Fusion) 전용. local=LM Studio 서브모델

# OpenRouter (LLM_PROVIDER=openrouter 일 때 사용)
OPENROUTER_API_KEY=                # [*] OpenRouter 키 (sk-or-...)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_DEFAULT=anthropic/claude-sonnet-4-6   # 파싱/생성 (intake 등)
OPENROUTER_MODEL_JUDGE=anthropic/claude-opus-4-7        # 영양/예산 검증 (judge)

# Anthropic 직결 (LLM_PROVIDER=anthropic 일 때만)
ANTHROPIC_API_KEY=                 # (openrouter 쓰면 비워둬도 됨)
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
ANTHROPIC_MODEL_JUDGE=claude-opus-4-7

# 로컬 서브모델 ID (RAG_LLM_PROVIDER=local 일 때 HyDE/Fusion 이 사용)
# 비우면 코드 기본값(qwen2.5-7b-instruct). 아래 5)의 모델 목록에서 골라 바꿀 수 있음.
LOCAL_MODEL_DEFAULT=qwen2.5-7b-instruct
LLM_LOCAL_BASE_URL=                # 비우면 LMSTUDIO_BASE_URL 로 폴백 (인증=LMSTUDIO_API_KEY)

# --- (B) 레거시 앱 에이전트 LLM  [app/llm.py] (orchestrator/meal/shopping) ---
# generate_json() 경로. mock 이면 식단이 고정(데모). 실 반응 쓰려면 openai + OpenRouter base.
FRIDGEMATE_LLM_PROVIDER=openai     # mock | openai | anthropic
FRIDGEMATE_LLM_BASE_URL=https://openrouter.ai/api/v1   # OpenAI 호환. 비우면 api.openai.com
FRIDGEMATE_LLM_MODEL=openai/gpt-4o-mini                # JSON 모드 지원 모델
OPENAI_API_KEY=                    # [*] OpenRouter 키(sk-or-...) 또는 OpenAI 키


# ============================================================================
# 2) Embedding — bge-m3 (LM Studio 원격)
#    인덱싱·검색이 같은 임베더여야 벡터공간 일치(EMBED_SIG 가드).
# ============================================================================
EMBED_PROVIDER=local               # local(LM Studio) | cohere | mock
LMSTUDIO_BASE_URL=http://58.148.250.103:1234/v1   # 로컬이면 http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=                  # [*] LM Studio Bearer 토큰 (임베딩+로컬챗 공용)
EMBED_MODEL_LOCAL=text-embedding-bge-m3            # 아래 5)의 임베딩 모델 중 선택
EMBED_SIG=bge-m3-1024              # 벡터공간 식별자 (인덱스<->쿼리 일치 가드)
COHERE_API_KEY=                    # (EMBED_PROVIDER=cohere 일 때만)
COHERE_MODEL=embed-multilingual-v3


# ============================================================================
# 3) Vector DB / 체크포인터
# ============================================================================
CHROMADB_PATH=./data/chroma        # 사전임베딩 산출물 (recipe_db 1693 동봉)
CHECKPOINTER_TYPE=memory           # memory | sqlite | postgres


# ============================================================================
# 4) 데이터 소스 키 (레시피 수집/재적재 — scripts/pipeline, scripts/ingest_recipes.py)
# ============================================================================
FOOD_SAFETY_API_KEY=               # [*] 식약처 COOKRCP01 (어디서나 호출 가능)
MAFRA_API_KEY=                     # [*] 농정원 레시피 (기본/재료/과정)
COOKRCP_LIMIT=1200                 # 식약처 수집 상한 (전체 ~1146)
MAFRA_LIMIT=1000                   # 농정원 기본정보 수집 상한 (~537)
MAFRA_NUTRITION_SERVICE=           # 농정원 영양결합 서비스 Grid_ID (미확정 — 채우면 영양 수집)
RDA_API_KEY=                       # 농진청 (옵션, 현재 스텁)


# ============================================================================
# 5) LM Studio 로컬 모델 목록 (참고 — 여러 개 중 골라 쓸 수 있음)
#    조회:  GET {LMSTUDIO_BASE_URL}/models   (Authorization: Bearer LMSTUDIO_API_KEY)
#    선택:  임베딩 -> EMBED_MODEL_LOCAL / 로컬 챗(서브쿼리) -> LOCAL_MODEL_DEFAULT 에 ID 기입
#    (아래는 2026-06-08 기준 58 서버 LM Studio 에 올라와 있던 17개 — 바뀔 수 있음)
#
#    [임베딩]
#      text-embedding-bge-m3            <- 현재 사용 (1024d, EMBED_SIG=bge-m3-1024)
#      text-embedding-kure-v1
#      text-embedding-nomic-embed-text-v1.5
#    [챗 — 작은 것부터]
#      qwen2.5-0.5b-instruct
#      llama_3.2_1b_intruct_tool_calling_v2
#      google/gemma-4-e4b
#      qwen3-4b-toolcalling-codex
#      qwen/qwen3-4b-thinking-2507
#      qwen2.5-7b-instruct              <- 현재 RAG 서브쿼리 기본
#      deepseek/deepseek-r1-0528-qwen3-8b
#      granite-3.0-8b-instruct
#      microsoft/phi-4
#      qwen/qwen3-14b
#      openai/gpt-oss-20b
#      qwen/qwen3-coder-30b
#      google/gemma-4-31b
#      granite-docling-258m


# ============================================================================
# 6) 외부 커머스 API (shopping/cart — 후속 범위)
# ============================================================================
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
COUPANG_PARTNER_ACCESS_KEY=
COUPANG_PARTNER_SECRET_KEY=


# ============================================================================
# 7) 인프라
# ============================================================================
REDIS_URL=redis://localhost:6379   # 없으면 in-memory 폴백
DATABASE_URL=postgresql://fridgemate:fridgemate@localhost:5432/fridgemate


# ============================================================================
# 8) 관측 (LangSmith) / Dev
# ============================================================================
LANGCHAIN_TRACING_V2=false         # true 면 LangSmith 트레이싱 (키 필요)
LANGCHAIN_API_KEY=                 # (LANGCHAIN_TRACING_V2=true 일 때, lsv2_...)
LANGCHAIN_PROJECT=fridgemate-merge
FRIDGEMATE_MOCK_MODE=true          # 외부 tool(쿠팡 등) mock — 임베딩/LLM 은 위 설정대로 real
